# Repository allowlist: local work may exist beside these deliverables.
/*
!/.gitignore
!/.python-version
!/README.md
!/pyproject.toml
!/uv.lock
!/datasets/
!/src/
!/scripts/
!/tests/
!/presentation/
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/publish-presentation.yml
!/plotting/
!/tools/
!/configs/
!/assets/
!/Question/
!/bibliography/
!/models/
!/output/
!/启动Studio.bat
!/启动Studio.command
!/SOLAR_Studio_Demo_Bilingual.mp4
!/SOLAR_Studio_Demo_Bilingual.srt
!/SOLAR_Studio_Demo_Bilingual_boxed.srt
!/SOLAR_Studio_Demo_Bilingual_boxed.ass
!/Report_final/
!/Contribution/
!/Q&A/
!songjiayun

# Local environments and generated intermediates anywhere in allowed directories.
.DS_Store
.cache/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.log
*.tmp
*.aux
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.xdv

# Model weights have exactly one home.
*.joblib
*.ckpt
*.pt
*.pth
*.safetensors
!/models/**/*.joblib
!/models/**/*.ckpt
!/models/**/*.pt
!/models/**/*.pth
!/models/**/*.safetensors

# Results contain tabular/numeric evidence and documentation only.
/output/**
!/output/**/
!/output/**/*.csv
!/output/**/*.json
!/output/**/*.txt
!/output/**/README.md
/output/playwright/
